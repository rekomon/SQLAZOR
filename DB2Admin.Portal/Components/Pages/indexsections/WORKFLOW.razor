<!-- ─── WORKFLOW ─── -->
<section class="workflow-section" id="workflow">
    <div class="container">
        <div class="section-header">
            <div class="badge-cyber"><i class="bi bi-diagram-3 me-1"></i> Workflow</div>
            <h2>From schema to shipped app</h2>
            <p>Four steps — and the AI joins you for the interesting ones.</p>
        </div>
        <div class="row g-4">
            <div class="col-md-6 col-lg-3">
                <div class="workflow-step step-compact">
                    <div class="step-number">01</div>
                    <div class="step-content">
                        <h5>Connect &amp; scan</h5>
                        <p>Point SqLazor at SQL Server with Windows or SQL auth. One scan maps tables, views, keys, and implicit relationships.</p>
                        <div class="text-muted small mt-2"><i class="bi bi-check-circle-fill me-1" style="color:var(--neon-cyan);"></i> SQL Server 2016+</div>
                    </div>
                </div>
            </div>
            <div class="col-md-6 col-lg-3">
                <div class="workflow-step step-compact">
                    <div class="step-number">02</div>
                    <div class="step-content">
                        <h5>Ask the AI</h5>
                        <p>Get a tour, a relationship map, or a query in plain English. Run read‑only SQL and chart the result inside the same reply.</p>
                        <div class="text-muted small mt-2"><i class="bi bi-check-circle-fill me-1" style="color:var(--neon-cyan);"></i> Ollama, OpenRouter or DeepSeek</div>
                    </div>
                </div>
            </div>
            <div class="col-md-6 col-lg-3">
                <div class="workflow-step step-compact">
                    <div class="step-number">03</div>
                    <div class="step-content">
                        <h5>Configure &amp; generate</h5>
                        <p>Pick tables, review the AI and scanned lookup suggestions, choose a page style, and save the choices as a profile. Then generate Blazor pages, DTOs, endpoints, and docs.</p>
                        <div class="text-muted small mt-2"><i class="bi bi-check-circle-fill me-1" style="color:var(--neon-cyan);"></i> Plain HTML · MudBlazor · Tabler</div>
                    </div>
                </div>
            </div>
            <div class="col-md-6 col-lg-3">
                <div class="workflow-step step-compact">
                    <div class="step-number">04</div>
                    <div class="step-content">
                        <h5>Review &amp; iterate</h5>
                        <p>Validate, deep‑compile, and preview the docs. Then let AI edit files with a diff preview and regenerate without losing your changes.</p>
                        <div class="text-muted small mt-2"><i class="bi bi-check-circle-fill me-1" style="color:var(--neon-cyan);"></i> Regeneration‑safe manifest</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
