@page "/generator"
@using SQLAZOR.Portal.Components.Pages.generatortabs
@using static SQLAZOR.Services.GenerationState
@inject GenerationState _State
@inject ISchemaReaderService SchemaReader
<PageTitle>Generator</PageTitle>
<section class="generator" id="generator">
<div class="container">
        <div class="row align-items-center g-5">
            <div class="col-12">
<div class="card slide-up mb-4 p-3" style="animation-delay:.35s;">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h5 class="card-title glitch-heading mb-0" style="font-family:var(--cu-font-cyber); color:var(--cu-text);
            text-transform:uppercase; letter-spacing:1px; font-size:0.9rem;">
             Get start to Generate a amazing admin control panel
        </h5>
                        <div class="d-flex align-items-center gap-2">
                            <ConnStatus Conn="_State.Conn" />
                    </div>
                           
                        
        </div>
    <div class="d-flex flex-column gap-4">

        <div>
            <ul class="nav nav-tabs" id="myTab" role="tablist">
                <li class="nav-item" role="presentation">
                                    <MudButton class="nav-link active" id="conntab-tab" data-bs-toggle="tab"
                                            data-bs-target="#conntab" type="button" role="tab">
                        SQL Connection
                    </MudButton>
                </li>
                <li class="nav-item" role="presentation" >

                    <MudButton class="nav-link" id="schema-tab" Disabled="@DisabledTabs"
                            data-bs-toggle="tab" data-bs-target="#schematab"
                            type="button" role="tab"> Schema
                    </MudButton>
                </li>
                <li class="nav-item" role="presentation">
                    <MudButton class="nav-link" id="AISAtab-tab" data-bs-toggle="tab" Disabled="@DisabledTabs"
                                               data-bs-target="#AISAtab" type="button" role="tab">
                        AI Assistant
                    </MudButton>

                </li>

                <li class="nav-item" role="presentation">
                                    <MudButton class="nav-link" id="AINameingDoc-tab" data-bs-toggle="tab" Disabled="@DisabledTabs"
                                               data-bs-target="#AINameingDoc" type="button" role="tab">
                        AI naming & documentation
                    </MudButton>

                </li>

                <li class="nav-item" role="presentation">
                                    <MudButton class="nav-link" id="ImplicitRelation-tab" data-bs-toggle="tab" Disabled="@DisabledTabs"
                                               data-bs-target="#ImplicitRelation" type="button" role="tab">
                        Implicit relationships
                    </MudButton>

                </li>

                <li class="nav-item" role="presentation">
                    <MudButton class="nav-link" id="tab6-tab" data-bs-toggle="tab" Disabled="@DisabledTabs"
                            data-bs-target="#tab6" type="button" role="tab">
                        Generate
                    </MudButton>

                </li>

                <li class="nav-item" role="presentation">
                    <MudButton class="nav-link" id="tab7-tab" data-bs-toggle="tab" Disabled="@DisabledTabs"
                            data-bs-target="#tab7" type="button" role="tab">
                        Results
                    </MudButton>

                </li>

            </ul>
            <div class="tab-content pt-3">
                  <div class="tab-pane fade active show" id="conntab" role="tabpanel">
                      <DBConnection Conn="_State.Conn" />
                 </div>

                 <div class="tab-pane fade" id="schematab" role="tabpanel">
                     <SchemaTab Schema="_State.Schema" SelectedTableKeys="_State.SelectedTableKeys" 
                     SelectedViewKeys="_State.SelectedViewKeys"
                     Procedures="_State.Procedures" SelectedProcedureKeys="_State.SelectedProcedureKeys" />
                </div>
                <div class="tab-pane fade" id="AISAtab" role="tabpanel">
                    <AISchemaAssistant/>
                    </div>
                <div class="tab-pane fade" id="AINameingDoc" role="tabpanel">
                                    <AINamingDocument Schema="_State.Schema" SelectedTableKeys="_State.SelectedTableKeys" AppliedNamingTableKeys="_State.AppliedNamingTableKeys"
                     NamingSuggestions="_State.NamingSuggestions"/>
                    </div>

                                <div class="tab-pane fade" id="ImplicitRelation" role="tabpanel">
                                    <ImplicitRelationTab Schema="_State.Schema" SelectedTableKeys="_State.SelectedTableKeys" 
                                    ImplicitFkCandidates="_State.ImplicitFkCandidates" 
                                    AcceptedImplicitFkKeys="_State.AcceptedImplicitFkKeys" />
                                </div>

            </div>
        </div>

      
    </div>
</div>
        </div>
</div>
</div>
</section>

@implements IDisposable

@code {

    bool DisabledTabs = true;
    protected override void OnInitialized()
    {
        _State.OnChange += StateHasChangedHandler;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_State.Conn.IsConnected)
        {
        }
    }  

    private void StateHasChangedHandler()
    {
        DisabledTabs = !_State.Conn.IsConnected;

        InvokeAsync(LoadSchemaAsync);
        InvokeAsync(StateHasChanged);

    }

    private async Task LoadSchemaAsync()
    {
        if (_State.Conn.IsConnected)
        {
            try
            {
                _State.Schema = await SchemaReader.ReadSchemaAsync(_State.Conn.ConnectionString, includeViews: true);
            }
            catch (Exception ex)
            {
                
            }
        }
    }



    public void Dispose()
    {
        _State.OnChange -= StateHasChangedHandler;
       
    }

}
