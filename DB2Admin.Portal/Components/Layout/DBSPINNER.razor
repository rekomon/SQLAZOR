<div class="db-relation-spinner" role="status" aria-label="Checking database relationships">
    <svg viewBox="0 0 120 120" xmlns="http://www.w3.org/2000/svg">
        <!-- Glow filter -->
        <defs>
            <filter id="neonGlow" x="-20%" y="-20%" width="140%" height="140%">
                <feGaussianBlur stdDeviation="3" result="blur" />
                <feMerge>
                    <feMergeNode in="blur" />
                    <feMergeNode in="SourceGraphic" />
                </feMerge>
            </filter>
            <linearGradient id="lineGrad" x1="0%" y1="0%" x2="100%" y2="0%">
                <stop offset="0%" stop-color="var(--cu-neon-cyan, #00f0ff)" stop-opacity="0.2" />
                <stop offset="50%" stop-color="var(--cu-neon-cyan, #00f0ff)" stop-opacity="1" />
                <stop offset="100%" stop-color="var(--cu-neon-cyan, #00f0ff)" stop-opacity="0.2" />
            </linearGradient>
        </defs>

        <!-- ===== RELATIONSHIP LINES ===== -->
        <!-- Line: Table A → Table B -->
        <line x1="35" y1="45" x2="75" y2="45" stroke="var(--cu-neon-cyan, #00f0ff)" stroke-width="2" stroke-dasharray="6,4" opacity="0.6">
            <animate attributeName="stroke-dashoffset" from="0" to="20" dur="1.2s" repeatCount="indefinite" />
        </line>
        <!-- Line: Table B → Table C -->
        <line x1="85" y1="55" x2="85" y2="75" stroke="var(--cu-neon-cyan, #00f0ff)" stroke-width="2" stroke-dasharray="6,4" opacity="0.6">
            <animate attributeName="stroke-dashoffset" from="0" to="20" dur="1.2s" repeatCount="indefinite" />
        </line>
        <!-- Line: Table A → Table C (diagonal) -->
        <line x1="45" y1="55" x2="75" y2="75" stroke="var(--cu-neon-cyan, #00f0ff)" stroke-width="1.5" stroke-dasharray="4,4" opacity="0.4">
            <animate attributeName="stroke-dashoffset" from="0" to="16" dur="1.8s" repeatCount="indefinite" />
        </line>

        <!-- ===== TABLE A (top-left) ===== -->
        <g filter="url(#neonGlow)">
            <rect x="15" y="30" width="40" height="28" rx="4" fill="var(--cu-card-bg, rgba(0,20,30,0.7))" stroke="var(--cu-neon-cyan, #00f0ff)" stroke-width="1.5">
                <animate attributeName="stroke-opacity" values="0.6;1;0.6" dur="2s" repeatCount="indefinite" />
            </rect>
            <!-- Table header -->
            <rect x="15" y="30" width="40" height="12" rx="4" fill="var(--cu-neon-cyan, #00f0ff)" fill-opacity="0.15">
                <animate attributeName="fill-opacity" values="0.1;0.25;0.1" dur="2.5s" repeatCount="indefinite" />
            </rect>
            <text x="35" y="39" font-family="monospace" font-size="7" fill="var(--cu-neon-cyan, #00f0ff)" text-anchor="middle" font-weight="bold">TA</text>
            <!-- Row indicators -->
            <circle cx="20" cy="48" r="2" fill="var(--cu-neon-cyan, #00f0ff)" opacity="0.6" />
            <circle cx="28" cy="48" r="2" fill="var(--cu-neon-cyan, #00f0ff)" opacity="0.6" />
            <circle cx="36" cy="48" r="2" fill="var(--cu-neon-cyan, #00f0ff)" opacity="0.6" />
            <circle cx="44" cy="48" r="2" fill="var(--cu-neon-cyan, #00f0ff)" opacity="0.6" />
        </g>

        <!-- ===== TABLE B (top-right) ===== -->
        <g filter="url(#neonGlow)">
            <rect x="65" y="30" width="40" height="28" rx="4" fill="var(--cu-card-bg, rgba(0,20,30,0.7))" stroke="var(--cu-neon-magenta, #ff00ff)" stroke-width="1.5">
                <animate attributeName="stroke-opacity" values="0.6;1;0.6" dur="2.3s" repeatCount="indefinite" />
            </rect>
            <rect x="65" y="30" width="40" height="12" rx="4" fill="var(--cu-neon-magenta, #ff00ff)" fill-opacity="0.15">
                <animate attributeName="fill-opacity" values="0.1;0.25;0.1" dur="2.8s" repeatCount="indefinite" />
            </rect>
            <text x="85" y="39" font-family="monospace" font-size="7" fill="var(--cu-neon-magenta, #ff00ff)" text-anchor="middle" font-weight="bold">TB</text>
            <circle cx="70" cy="48" r="2" fill="var(--cu-neon-magenta, #ff00ff)" opacity="0.6" />
            <circle cx="78" cy="48" r="2" fill="var(--cu-neon-magenta, #ff00ff)" opacity="0.6" />
            <circle cx="86" cy="48" r="2" fill="var(--cu-neon-magenta, #ff00ff)" opacity="0.6" />
            <circle cx="94" cy="48" r="2" fill="var(--cu-neon-magenta, #ff00ff)" opacity="0.6" />
        </g>

        <!-- ===== TABLE C (bottom-center) ===== -->
        <g filter="url(#neonGlow)">
            <rect x="40" y="65" width="40" height="28" rx="4" fill="var(--cu-card-bg, rgba(0,20,30,0.7))" stroke="var(--cu-neon-yellow, #ffff00)" stroke-width="1.5">
                <animate attributeName="stroke-opacity" values="0.6;1;0.6" dur="2.7s" repeatCount="indefinite" />
            </rect>
            <rect x="40" y="65" width="40" height="12" rx="4" fill="var(--cu-neon-yellow, #ffff00)" fill-opacity="0.15">
                <animate attributeName="fill-opacity" values="0.1;0.25;0.1" dur="3s" repeatCount="indefinite" />
            </rect>
            <text x="60" y="74" font-family="monospace" font-size="7" fill="var(--cu-neon-yellow, #ffff00)" text-anchor="middle" font-weight="bold">TC</text>
            <circle cx="45" cy="83" r="2" fill="var(--cu-neon-yellow, #ffff00)" opacity="0.6" />
            <circle cx="53" cy="83" r="2" fill="var(--cu-neon-yellow, #ffff00)" opacity="0.6" />
            <circle cx="61" cy="83" r="2" fill="var(--cu-neon-yellow, #ffff00)" opacity="0.6" />
            <circle cx="69" cy="83" r="2" fill="var(--cu-neon-yellow, #ffff00)" opacity="0.6" />
        </g>

        <!-- ===== SCANNING PULSE (outer ring) ===== -->
        <circle cx="60" cy="55" r="52" fill="none" stroke="var(--cu-neon-cyan, #00f0ff)" stroke-width="1" opacity="0.2">
            <animate attributeName="r" values="48;58;48" dur="2s" repeatCount="indefinite" />
            <animate attributeName="opacity" values="0.4;0.05;0.4" dur="2s" repeatCount="indefinite" />
        </circle>
        <circle cx="60" cy="55" r="48" fill="none" stroke="var(--cu-neon-cyan, #00f0ff)" stroke-width="0.5" opacity="0.1">
            <animate attributeName="r" values="45;55;45" dur="2.5s" repeatCount="indefinite" />
        </circle>

        <!-- ===== CORNER BRACKETS (cyberpunk framing) ===== -->
        <path d="M8 8 L18 8 L18 18" fill="none" stroke="var(--cu-neon-cyan, #00f0ff)" stroke-width="1.5" opacity="0.4" />
        <path d="M112 8 L102 8 L102 18" fill="none" stroke="var(--cu-neon-cyan, #00f0ff)" stroke-width="1.5" opacity="0.4" />
        <path d="M8 112 L18 112 L18 102" fill="none" stroke="var(--cu-neon-cyan, #00f0ff)" stroke-width="1.5" opacity="0.4" />
        <path d="M112 112 L102 112 L102 102" fill="none" stroke="var(--cu-neon-cyan, #00f0ff)" stroke-width="1.5" opacity="0.4" />
    </svg>

    <!-- Status text below the spinner -->
    <div class="spinner-label">
        <span class="label-main">@Title</span>
        <span class="label-sub">@Subtitle</span>
    </div>
</div>

@code{
    [Parameter]
    public string Title { get; set; } = "Checking";
    [Parameter]
    public string Subtitle { get; set; } = "Scanning";
}