@* auto-generated by SQLAZOR - hand-edit freely, this file is not regenerated automatically *@
@page "/products"
@inject IProductService Service

<PageTitle>Products</PageTitle>

<h3>Products</h3>

<a href="/products/create" class="btn btn-primary mb-3">+ New Product</a>

@if (_loading)
{
    <p>Loading…</p>
}
else if (!string.IsNullOrEmpty(_error))
{
    <div class="alert alert-danger">@_error</div>
}
else if (_items.Count == 0)
{
    <p>No records found.</p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>ProductId</th>
                <th>Sku</th>
                <th>Name</th>
                <th>Category</th>
                <th>Price</th>
                <th>Stock</th>
                <th>StockValue</th>
                <th>AddedOn</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in _items)
            {
                <tr>
                    <td>@item.ProductId</td>
                    <td>@item.Sku</td>
                    <td>@item.Name</td>
                    <td>@item.Category</td>
                    <td>@item.Price</td>
                    <td>@item.Stock</td>
                    <td>@item.StockValue</td>
                    <td>@item.AddedOn</td>
                    <td>
                        <a href="@GetEditUrl(item)" class="btn btn-sm btn-secondary">Edit</a>
                        <button class="btn btn-sm btn-danger" @onclick="() => DeleteAsync(item)">Delete</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<ProductDto> _items = [];
    private bool _loading = true;
    private string? _error;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;

        var result = await Service.GetAllAsync();
        if (result.IsSuccessful)
        {
            _items = result.Data ?? [];
        }
        else
        {
            _error = result.Message;
        }

        _loading = false;
    }

    private async Task DeleteAsync(ProductDto item)
    {
        var result = await Service.DeleteAsync(item.ProductId);
        if (result.IsSuccessful)
        {
            await LoadAsync();
        }
        else
        {
            _error = result.Message;
        }
    }

    private static string GetEditUrl(ProductDto item) => $"/products/edit/{item.ProductId}";
}
