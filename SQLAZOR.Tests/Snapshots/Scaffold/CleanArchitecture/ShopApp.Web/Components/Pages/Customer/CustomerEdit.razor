@* auto-generated by SQLAZOR - hand-edit freely, this file is not regenerated automatically *@
@page "/customers/edit/{Id:int}"
@inject ICustomerService Service
@inject NavigationManager Nav

<PageTitle>Edit Customer</PageTitle>

<h3>Edit Customer</h3>

@if (_loading)
{
    <p>Loading…</p>
}
else
{
    @if (!string.IsNullOrEmpty(_error))
    {
        <div class="alert alert-danger">@_error</div>
    }

    <EditForm Model="_model" OnValidSubmit="SubmitAsync">
        <div class="mb-3">
            <label class="form-label" for="_model_FirstName">FirstName</label>
            <input type="text" class="form-control" id="_model_FirstName" @bind-value="_model.FirstName" />
        </div>
        <div class="mb-3">
            <label class="form-label" for="_model_LastName">LastName</label>
            <input type="text" class="form-control" id="_model_LastName" @bind-value="_model.LastName" />
        </div>
        <div class="mb-3">
            <label class="form-label" for="_model_Email">Email</label>
            <input type="text" class="form-control" id="_model_Email" @bind-value="_model.Email" />
        </div>
        <div class="mb-3">
            <label class="form-label" for="_model_CreatedAt">CreatedAt</label>
            <input type="datetime-local" class="form-control" id="_model_CreatedAt" @bind-value="_model.CreatedAt" />
        </div>
        @* RowVersion (rowversion) isn't auto-renderable - add a field for it by hand if needed *@
        <button type="submit" class="btn btn-primary" disabled="@_saving">Save</button>
        <a href="/customers" class="btn btn-secondary">Cancel</a>
    </EditForm>
}

@code {
    [Parameter] public int Id { get; set; }

    private const string ListUrl = "/customers";
    private bool _loading = true;
    private bool _saving;
    private string? _error;
    private CustomerUpdateDto _model = new();

    protected override async Task OnInitializedAsync()
    {
        var result = await Service.GetByIdAsync(Id);
        if (result.IsSuccessful && result.Data is not null)
        {
            _model.FirstName = result.Data.FirstName;
            _model.LastName = result.Data.LastName;
            _model.Email = result.Data.Email;
            _model.CreatedAt = result.Data.CreatedAt;
            _model.RowVersion = result.Data.RowVersion;
        }
        else
        {
            _error = result.Message ?? "Customer not found.";
        }

        _loading = false;
    }

    private async Task SubmitAsync()
    {
        _saving = true;
        _error = null;

        var result = await Service.UpdateAsync(Id, _model);
        if (result.IsSuccessful)
        {
            Nav.NavigateTo(ListUrl);
        }
        else
        {
            _error = result.Message;
            _saving = false;
        }
    }
}
