@* auto-generated by SQLAZOR - hand-edit freely, this file is not regenerated automatically *@
@page "/orderlines/create"
@inject IOrderLineService Service
@inject IOrderService OrderLookupService
@inject IProductService ProductLookupService
@inject NavigationManager Nav

<PageTitle>New OrderLine</PageTitle>

<h3>New OrderLine</h3>

@if (!string.IsNullOrEmpty(_error))
{
    <div class="alert alert-danger">@_error</div>
}

<EditForm Model="_model" OnValidSubmit="SubmitAsync">
    <div class="mb-3">
        <label class="form-label" for="_model_OrderId">Order</label>
        <input type="search" class="form-control form-control-sm mb-1" placeholder="Search…" @bind="_lookupOrderIdSearch" @bind:event="oninput" />
        <select class="form-select" id="_model_OrderId" @bind="_model.OrderId">
            @foreach (var option in _lookupOrder.Where(o => MatchesOrderId(o, _lookupOrderIdSearch)))
            {
                <option value="@option.OrderId">@($"Order #{option.OrderId}")</option>
            }
        </select>
    </div>
    <div class="mb-3">
        <label class="form-label" for="_model_LineNumber">LineNumber</label>
        <input type="number" class="form-control" id="_model_LineNumber" @bind-value="_model.LineNumber" />
    </div>
    <div class="mb-3">
        <label class="form-label" for="_model_ProductId">Product</label>
        <input type="search" class="form-control form-control-sm mb-1" placeholder="Search…" @bind="_lookupProductIdSearch" @bind:event="oninput" />
        <select class="form-select" id="_model_ProductId" @bind="_model.ProductId">
            @foreach (var option in _lookupProduct.Where(o => MatchesProductId(o, _lookupProductIdSearch)))
            {
                <option value="@option.ProductId">@option.Name</option>
            }
        </select>
    </div>
    <div class="mb-3">
        <label class="form-label" for="_model_Quantity">Quantity</label>
        <input type="number" class="form-control" id="_model_Quantity" @bind-value="_model.Quantity" />
    </div>
    <div class="mb-3">
        <label class="form-label" for="_model_UnitPrice">UnitPrice</label>
        <input type="number" class="form-control" id="_model_UnitPrice" @bind-value="_model.UnitPrice" />
    </div>
    <button type="submit" class="btn btn-primary" disabled="@_saving">Create</button>
    <a href="/orderlines" class="btn btn-secondary">Cancel</a>
</EditForm>

@code {
    private const string ListUrl = "/orderlines";
    private bool _saving;
    private string? _error;
    private OrderLineCreateDto _model = new();
    private List<OrderDto> _lookupOrder = [];
    private List<ProductDto> _lookupProduct = [];
    private string? _lookupOrderIdSearch;
    private static bool MatchesOrderId(OrderDto option, string? term) =>
        string.IsNullOrWhiteSpace(term) || ($"Order #{option.OrderId}" ?? string.Empty).Contains(term.Trim(), StringComparison.OrdinalIgnoreCase);
    private string? _lookupProductIdSearch;
    private static bool MatchesProductId(ProductDto option, string? term) =>
        string.IsNullOrWhiteSpace(term) || (option.Name ?? string.Empty).Contains(term.Trim(), StringComparison.OrdinalIgnoreCase);

    protected override async Task OnInitializedAsync()
    {
        var lookupOrder = await OrderLookupService.GetAllAsync();
        if (lookupOrder.IsSuccessful) _lookupOrder = lookupOrder.Data ?? [];
        var lookupProduct = await ProductLookupService.GetAllAsync();
        if (lookupProduct.IsSuccessful) _lookupProduct = lookupProduct.Data ?? [];
    }

    private async Task SubmitAsync()
    {
        _saving = true;
        _error = null;

        var result = await Service.CreateAsync(_model);
        if (result.IsSuccessful)
        {
            Nav.NavigateTo(ListUrl);
        }
        else
        {
            _error = result.Message;
            _saving = false;
        }
    }
}
