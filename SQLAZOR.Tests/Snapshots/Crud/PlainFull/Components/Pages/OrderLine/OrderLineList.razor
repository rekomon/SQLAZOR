@* auto-generated by SQLAZOR - hand-edit freely, this file is not regenerated automatically *@
@page "/orderlines"
@inject IOrderLineService Service

<PageTitle>OrderLines</PageTitle>

<h3>OrderLines</h3>

<a href="/orderlines/create" class="btn btn-primary mb-3">+ New OrderLine</a>

@if (_loading)
{
    <p>Loading…</p>
}
else if (!string.IsNullOrEmpty(_error))
{
    <div class="alert alert-danger">@_error</div>
}
else if (_items.Count == 0)
{
    <p>No records found.</p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>OrderId</th>
                <th>LineNumber</th>
                <th>ProductId</th>
                <th>Quantity</th>
                <th>UnitPrice</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in _items)
            {
                <tr>
                    <td>@item.OrderId</td>
                    <td>@item.LineNumber</td>
                    <td>@item.ProductId</td>
                    <td>@item.Quantity</td>
                    <td>@item.UnitPrice</td>
                    <td>
                        <a href="@GetEditUrl(item)" class="btn btn-sm btn-secondary">Edit</a>
                        <button class="btn btn-sm btn-danger" @onclick="() => DeleteAsync(item)">Delete</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<OrderLineDto> _items = [];
    private bool _loading = true;
    private string? _error;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;

        var result = await Service.GetAllAsync();
        if (result.IsSuccessful)
        {
            _items = result.Data ?? [];
        }
        else
        {
            _error = result.Message;
        }

        _loading = false;
    }

    private async Task DeleteAsync(OrderLineDto item)
    {
        var result = await Service.DeleteAsync(item.OrderId, item.LineNumber);
        if (result.IsSuccessful)
        {
            await LoadAsync();
        }
        else
        {
            _error = result.Message;
        }
    }

    private static string GetEditUrl(OrderLineDto item) => $"/orderlines/edit/{item.OrderId}/{item.LineNumber}";
}
