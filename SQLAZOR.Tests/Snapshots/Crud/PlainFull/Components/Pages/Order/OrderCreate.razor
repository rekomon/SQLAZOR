@* auto-generated by SQLAZOR - hand-edit freely, this file is not regenerated automatically *@
@page "/orders/create"
@inject IOrderService Service
@inject ICustomerService CustomerLookupService
@inject NavigationManager Nav

<PageTitle>New Order</PageTitle>

<h3>New Order</h3>

@if (!string.IsNullOrEmpty(_error))
{
    <div class="alert alert-danger">@_error</div>
}

<EditForm Model="_model" OnValidSubmit="SubmitAsync">
    <div class="mb-3">
        <label class="form-label" for="_model_CustomerId">Customer</label>
        <input type="search" class="form-control form-control-sm mb-1" placeholder="Search…" @bind="_lookupCustomerIdSearch" @bind:event="oninput" />
        <select class="form-select" id="_model_CustomerId" @bind="_model.CustomerId">
            @foreach (var option in _lookupCustomer.Where(o => MatchesCustomerId(o, _lookupCustomerIdSearch)))
            {
                <option value="@option.CustomerId">@($"{option.FirstName} {option.LastName}")</option>
            }
        </select>
    </div>
    <div class="mb-3">
        <label class="form-label" for="_model_ShippedToCustomerId">Shipped To Customer</label>
        <input type="search" class="form-control form-control-sm mb-1" placeholder="Search…" @bind="_lookupShippedToCustomerIdSearch" @bind:event="oninput" />
        <select class="form-select" id="_model_ShippedToCustomerId" @bind="_model.ShippedToCustomerId">
            <option value="">—</option>
            @foreach (var option in _lookupCustomer.Where(o => MatchesShippedToCustomerId(o, _lookupShippedToCustomerIdSearch)))
            {
                <option value="@option.CustomerId">@($"{option.FirstName} {option.LastName}")</option>
            }
        </select>
    </div>
    <div class="mb-3">
        <label class="form-label" for="_model_OrderDate">OrderDate</label>
        <input type="datetime-local" class="form-control" id="_model_OrderDate" @bind-value="_model.OrderDate" />
    </div>
    <div class="mb-3">
        <label class="form-label" for="_model_Total">Total</label>
        <input type="number" class="form-control" id="_model_Total" @bind-value="_model.Total" />
    </div>
    <div class="mb-3">
        <label class="form-label" for="_model_Status">Status</label>
        <input type="text" class="form-control" id="_model_Status" @bind-value="_model.Status" />
    </div>
    @* RowVersion (rowversion) isn't auto-renderable - add a field for it by hand if needed *@
    <button type="submit" class="btn btn-primary" disabled="@_saving">Create</button>
    <a href="/orders" class="btn btn-secondary">Cancel</a>
</EditForm>

@code {
    private const string ListUrl = "/orders";
    private bool _saving;
    private string? _error;
    private OrderCreateDto _model = new();
    private List<CustomerDto> _lookupCustomer = [];
    private string? _lookupCustomerIdSearch;
    private static bool MatchesCustomerId(CustomerDto option, string? term) =>
        string.IsNullOrWhiteSpace(term) || ($"{option.FirstName} {option.LastName}" ?? string.Empty).Contains(term.Trim(), StringComparison.OrdinalIgnoreCase);
    private string? _lookupShippedToCustomerIdSearch;
    private static bool MatchesShippedToCustomerId(CustomerDto option, string? term) =>
        string.IsNullOrWhiteSpace(term) || ($"{option.FirstName} {option.LastName}" ?? string.Empty).Contains(term.Trim(), StringComparison.OrdinalIgnoreCase);

    protected override async Task OnInitializedAsync()
    {
        var lookupCustomer = await CustomerLookupService.GetAllAsync();
        if (lookupCustomer.IsSuccessful) _lookupCustomer = lookupCustomer.Data ?? [];
    }

    private async Task SubmitAsync()
    {
        _saving = true;
        _error = null;

        var result = await Service.CreateAsync(_model);
        if (result.IsSuccessful)
        {
            Nav.NavigateTo(ListUrl);
        }
        else
        {
            _error = result.Message;
            _saving = false;
        }
    }
}
