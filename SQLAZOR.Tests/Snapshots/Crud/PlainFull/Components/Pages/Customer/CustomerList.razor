@* auto-generated by SQLAZOR - hand-edit freely, this file is not regenerated automatically *@
@page "/customers"
@inject ICustomerService Service

<PageTitle>Customers</PageTitle>

<h3>Customers</h3>

<a href="/customers/create" class="btn btn-primary mb-3">+ New Customer</a>

@if (_loading)
{
    <p>Loading…</p>
}
else if (!string.IsNullOrEmpty(_error))
{
    <div class="alert alert-danger">@_error</div>
}
else if (_items.Count == 0)
{
    <p>No records found.</p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>CustomerId</th>
                <th>FirstName</th>
                <th>LastName</th>
                <th>Email</th>
                <th>CreatedAt</th>
                <th>RowVersion</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in _items)
            {
                <tr>
                    <td>@item.CustomerId</td>
                    <td>@item.FirstName</td>
                    <td>@item.LastName</td>
                    <td>@item.Email</td>
                    <td>@item.CreatedAt</td>
                    <td>@item.RowVersion</td>
                    <td>
                        <a href="@GetEditUrl(item)" class="btn btn-sm btn-secondary">Edit</a>
                        <button class="btn btn-sm btn-danger" @onclick="() => DeleteAsync(item)">Delete</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<CustomerDto> _items = [];
    private bool _loading = true;
    private string? _error;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;

        var result = await Service.GetAllAsync();
        if (result.IsSuccessful)
        {
            _items = result.Data ?? [];
        }
        else
        {
            _error = result.Message;
        }

        _loading = false;
    }

    private async Task DeleteAsync(CustomerDto item)
    {
        var result = await Service.DeleteAsync(item.CustomerId);
        if (result.IsSuccessful)
        {
            await LoadAsync();
        }
        else
        {
            _error = result.Message;
        }
    }

    private static string GetEditUrl(CustomerDto item) => $"/customers/edit/{item.CustomerId}";
}
