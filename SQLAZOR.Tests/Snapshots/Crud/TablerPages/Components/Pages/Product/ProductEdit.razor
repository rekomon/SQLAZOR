@* auto-generated by SQLAZOR - hand-edit freely, this file is not regenerated automatically *@
@page "/products/edit/{Id:int}"
@inject IProductService Service
@inject NavigationManager Nav

<PageTitle>Edit Product</PageTitle>

<div class="page-header d-print-none">
    <div class="row align-items-center">
        <div class="col">
            <h2 class="page-title">Edit Product</h2>
        </div>
    </div>
</div>

@if (_loading)
{
    <div class="text-secondary">Loading…</div>
}
else
{
    @if (!string.IsNullOrEmpty(_error))
    {
        <div class="alert alert-danger">@_error</div>
    }

    <div class="card">
        <div class="card-body">
            <EditForm Model="_model" OnValidSubmit="SubmitAsync">
                <div class="mb-3">
                    <label class="form-label" for="_model_Sku">Sku</label>
                    <input type="text" class="form-control" id="_model_Sku" @bind-value="_model.Sku" />
                </div>
                <div class="mb-3">
                    <label class="form-label" for="_model_Name">Name</label>
                    <input type="text" class="form-control" id="_model_Name" @bind-value="_model.Name" />
                </div>
                <div class="mb-3">
                    <label class="form-label" for="_model_Category">Category</label>
                    <input type="text" class="form-control" id="_model_Category" @bind-value="_model.Category" />
                </div>
                <div class="mb-3">
                    <label class="form-label" for="_model_Price">Price</label>
                    <input type="number" class="form-control" id="_model_Price" @bind-value="_model.Price" />
                </div>
                <div class="mb-3">
                    <label class="form-label" for="_model_Stock">Stock</label>
                    <input type="number" class="form-control" id="_model_Stock" @bind-value="_model.Stock" />
                </div>
                <div class="mb-3">
                    <label class="form-label" for="_model_AddedOn">AddedOn</label>
                    <input type="text" class="form-control" id="_model_AddedOn" @bind-value="_model.AddedOn" />
                </div>
                <div class="mb-3 form-check">
                    <input type="checkbox" class="form-check-input" id="_model_IsActive" @bind-value="_model.IsActive" />
                    <label class="form-check-label" for="_model_IsActive">IsActive</label>
                </div>
                <div class="form-footer">
                    <button type="submit" class="btn btn-primary" disabled="@_saving">Save</button>
                    <a href="/products" class="btn btn-link">Cancel</a>
                </div>
            </EditForm>
        </div>
    </div>
}

@code {
    [Parameter] public int Id { get; set; }

    private const string ListUrl = "/products";
    private bool _loading = true;
    private bool _saving;
    private string? _error;
    private ProductUpdateDto _model = new();

    protected override async Task OnInitializedAsync()
    {
        var result = await Service.GetByIdAsync(Id);
        if (result.IsSuccessful && result.Data is not null)
        {
            _model.Sku = result.Data.Sku;
            _model.Name = result.Data.Name;
            _model.Category = result.Data.Category;
            _model.Price = result.Data.Price;
            _model.Stock = result.Data.Stock;
            _model.AddedOn = result.Data.AddedOn;
            _model.IsActive = result.Data.IsActive;
        }
        else
        {
            _error = result.Message ?? "Product not found.";
        }

        _loading = false;
    }

    private async Task SubmitAsync()
    {
        _saving = true;
        _error = null;

        var result = await Service.UpdateAsync(Id, _model);
        if (result.IsSuccessful)
        {
            Nav.NavigateTo(ListUrl);
        }
        else
        {
            _error = result.Message;
            _saving = false;
        }
    }
}
