@* auto-generated by SQLAZOR - hand-edit freely, this file is not regenerated automatically *@
@page "/orderlines/edit/{OrderId:int}/{LineNumber:int}"
@inject IOrderLineService Service
@inject IProductService ProductLookupService
@inject NavigationManager Nav

<PageTitle>Edit OrderLine</PageTitle>

<div class="page-header d-print-none">
    <div class="row align-items-center">
        <div class="col">
            <h2 class="page-title">Edit OrderLine</h2>
        </div>
    </div>
</div>

@if (_loading)
{
    <div class="text-secondary">Loading…</div>
}
else
{
    @if (!string.IsNullOrEmpty(_error))
    {
        <div class="alert alert-danger">@_error</div>
    }

    <div class="card">
        <div class="card-body">
            <EditForm Model="_model" OnValidSubmit="SubmitAsync">
                <div class="mb-3">
                    <label class="form-label" for="_model_ProductId">Product</label>
                    <input type="search" class="form-control form-control-sm mb-1" placeholder="Search…" @bind="_lookupProductIdSearch" @bind:event="oninput" />
                    <select class="form-select" id="_model_ProductId" @bind="_model.ProductId">
                        @foreach (var option in _lookupProduct.Where(o => MatchesProductId(o, _lookupProductIdSearch)))
                        {
                            <option value="@option.ProductId">@option.Name</option>
                        }
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label" for="_model_Quantity">Quantity</label>
                    <input type="number" class="form-control" id="_model_Quantity" @bind-value="_model.Quantity" />
                </div>
                <div class="mb-3">
                    <label class="form-label" for="_model_UnitPrice">UnitPrice</label>
                    <input type="number" class="form-control" id="_model_UnitPrice" @bind-value="_model.UnitPrice" />
                </div>
                <div class="form-footer">
                    <button type="submit" class="btn btn-primary" disabled="@_saving">Save</button>
                    <a href="/orderlines" class="btn btn-link">Cancel</a>
                </div>
            </EditForm>
        </div>
    </div>
}

@code {
    [Parameter] public int OrderId { get; set; }
    [Parameter] public int LineNumber { get; set; }

    private const string ListUrl = "/orderlines";
    private bool _loading = true;
    private bool _saving;
    private string? _error;
    private OrderLineUpdateDto _model = new();
    private List<ProductDto> _lookupProduct = [];
    private string? _lookupProductIdSearch;
    private static bool MatchesProductId(ProductDto option, string? term) =>
        string.IsNullOrWhiteSpace(term) || (option.Name ?? string.Empty).Contains(term.Trim(), StringComparison.OrdinalIgnoreCase);

    protected override async Task OnInitializedAsync()
    {
        var result = await Service.GetByIdAsync(OrderId, LineNumber);
        if (result.IsSuccessful && result.Data is not null)
        {
            _model.ProductId = result.Data.ProductId;
            _model.Quantity = result.Data.Quantity;
            _model.UnitPrice = result.Data.UnitPrice;
        }
        else
        {
            _error = result.Message ?? "OrderLine not found.";
        }

        var lookupProduct = await ProductLookupService.GetAllAsync();
        if (lookupProduct.IsSuccessful) _lookupProduct = lookupProduct.Data ?? [];
        _loading = false;
    }

    private async Task SubmitAsync()
    {
        _saving = true;
        _error = null;

        var result = await Service.UpdateAsync(OrderId, LineNumber, _model);
        if (result.IsSuccessful)
        {
            Nav.NavigateTo(ListUrl);
        }
        else
        {
            _error = result.Message;
            _saving = false;
        }
    }
}
