@* auto-generated by SQLAZOR - hand-edit freely, this file is not regenerated automatically *@
@page "/orderlines"
@inject IOrderLineService Service

<PageTitle>OrderLines</PageTitle>

<div class="page-header d-print-none">
    <div class="row align-items-center">
        <div class="col">
            <h2 class="page-title">OrderLines</h2>
        </div>
        <div class="col-auto ms-auto">
            <a href="/orderlines/create" class="btn btn-primary">+ New OrderLine</a>
        </div>
    </div>
</div>

@if (_loading)
{
    <div class="text-secondary">Loading…</div>
}
else if (!string.IsNullOrEmpty(_error))
{
    <div class="alert alert-danger">@_error</div>
}
else if (_items.Count == 0)
{
    <div class="text-secondary">No records found.</div>
}
else
{
    <div class="card">
        <div class="table-responsive">
            <table class="table table-vcenter card-table">
                <thead>
                    <tr>
                        <th>OrderId</th>
                        <th>LineNumber</th>
                        <th>ProductId</th>
                        <th>Quantity</th>
                        <th>UnitPrice</th>
                        <th class="w-1"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in _items)
                    {
                        <tr>
                            <td>@item.OrderId</td>
                            <td>@item.LineNumber</td>
                            <td>@item.ProductId</td>
                            <td>@item.Quantity</td>
                            <td>@item.UnitPrice</td>
                            <td class="text-nowrap">
                                <a href="@GetEditUrl(item)" class="btn btn-sm btn-outline-secondary">Edit</a>
                                <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteAsync(item)">Delete</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@code {
    private List<OrderLineDto> _items = [];
    private bool _loading = true;
    private string? _error;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;

        var result = await Service.GetAllAsync();
        if (result.IsSuccessful)
        {
            _items = result.Data ?? [];
        }
        else
        {
            _error = result.Message;
        }

        _loading = false;
    }

    private async Task DeleteAsync(OrderLineDto item)
    {
        var result = await Service.DeleteAsync(item.OrderId, item.LineNumber);
        if (result.IsSuccessful)
        {
            await LoadAsync();
        }
        else
        {
            _error = result.Message;
        }
    }

    private static string GetEditUrl(OrderLineDto item) => $"/orderlines/edit/{item.OrderId}/{item.LineNumber}";
}
