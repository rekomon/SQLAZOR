@* auto-generated by SQLAZOR - hand-edit freely, this file is not regenerated automatically *@
@page "/customers"
@inject ICustomerService Service

<PageTitle>Customers</PageTitle>

<div class="page-header d-print-none">
    <div class="row align-items-center">
        <div class="col">
            <h2 class="page-title">Customers</h2>
        </div>
        <div class="col-auto ms-auto">
            <a href="/customers/create" class="btn btn-primary">+ New Customer</a>
        </div>
    </div>
</div>

@if (_loading)
{
    <div class="text-secondary">Loading…</div>
}
else if (!string.IsNullOrEmpty(_error))
{
    <div class="alert alert-danger">@_error</div>
}
else if (_items.Count == 0)
{
    <div class="text-secondary">No records found.</div>
}
else
{
    <div class="card">
        <div class="table-responsive">
            <table class="table table-vcenter card-table">
                <thead>
                    <tr>
                        <th>CustomerId</th>
                        <th>FirstName</th>
                        <th>LastName</th>
                        <th>Email</th>
                        <th>CreatedAt</th>
                        <th>RowVersion</th>
                        <th class="w-1"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in _items)
                    {
                        <tr>
                            <td>@item.CustomerId</td>
                            <td>@item.FirstName</td>
                            <td>@item.LastName</td>
                            <td>@item.Email</td>
                            <td>@item.CreatedAt</td>
                            <td>@item.RowVersion</td>
                            <td class="text-nowrap">
                                <a href="@GetEditUrl(item)" class="btn btn-sm btn-outline-secondary">Edit</a>
                                <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteAsync(item)">Delete</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@code {
    private List<CustomerDto> _items = [];
    private bool _loading = true;
    private string? _error;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;

        var result = await Service.GetAllAsync();
        if (result.IsSuccessful)
        {
            _items = result.Data ?? [];
        }
        else
        {
            _error = result.Message;
        }

        _loading = false;
    }

    private async Task DeleteAsync(CustomerDto item)
    {
        var result = await Service.DeleteAsync(item.CustomerId);
        if (result.IsSuccessful)
        {
            await LoadAsync();
        }
        else
        {
            _error = result.Message;
        }
    }

    private static string GetEditUrl(CustomerDto item) => $"/customers/edit/{item.CustomerId}";
}
