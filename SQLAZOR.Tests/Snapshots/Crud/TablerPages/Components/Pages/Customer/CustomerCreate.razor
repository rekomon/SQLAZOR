@* auto-generated by SQLAZOR - hand-edit freely, this file is not regenerated automatically *@
@page "/customers/create"
@inject ICustomerService Service
@inject NavigationManager Nav

<PageTitle>New Customer</PageTitle>

<div class="page-header d-print-none">
    <div class="row align-items-center">
        <div class="col">
            <h2 class="page-title">New Customer</h2>
        </div>
    </div>
</div>

@if (!string.IsNullOrEmpty(_error))
{
    <div class="alert alert-danger">@_error</div>
}

<div class="card">
    <div class="card-body">
        <EditForm Model="_model" OnValidSubmit="SubmitAsync">
            <div class="mb-3">
                <label class="form-label" for="_model_FirstName">FirstName</label>
                <input type="text" class="form-control" id="_model_FirstName" @bind-value="_model.FirstName" />
            </div>
            <div class="mb-3">
                <label class="form-label" for="_model_LastName">LastName</label>
                <input type="text" class="form-control" id="_model_LastName" @bind-value="_model.LastName" />
            </div>
            <div class="mb-3">
                <label class="form-label" for="_model_Email">Email</label>
                <input type="text" class="form-control" id="_model_Email" @bind-value="_model.Email" />
            </div>
            <div class="mb-3">
                <label class="form-label" for="_model_CreatedAt">CreatedAt</label>
                <input type="datetime-local" class="form-control" id="_model_CreatedAt" @bind-value="_model.CreatedAt" />
            </div>
            @* RowVersion (rowversion) isn't auto-renderable - add a field for it by hand if needed *@
            <div class="form-footer">
                <button type="submit" class="btn btn-primary" disabled="@_saving">Create</button>
                <a href="/customers" class="btn btn-link">Cancel</a>
            </div>
        </EditForm>
    </div>
</div>

@code {
    private const string ListUrl = "/customers";
    private bool _saving;
    private string? _error;
    private CustomerCreateDto _model = new();

    private async Task SubmitAsync()
    {
        _saving = true;
        _error = null;

        var result = await Service.CreateAsync(_model);
        if (result.IsSuccessful)
        {
            Nav.NavigateTo(ListUrl);
        }
        else
        {
            _error = result.Message;
            _saving = false;
        }
    }
}
