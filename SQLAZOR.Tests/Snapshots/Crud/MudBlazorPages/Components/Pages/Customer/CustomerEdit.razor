@* auto-generated by SQLAZOR - hand-edit freely, this file is not regenerated automatically *@
@page "/customers/edit/{Id:int}"
@using MudBlazor
@inject ICustomerService Service
@inject NavigationManager Nav

<PageTitle>Edit Customer</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">Edit Customer</MudText>

@if (_loading)
{
    <MudProgressCircular Indeterminate="true" />
}
else
{
    @if (!string.IsNullOrEmpty(_error))
    {
        <MudAlert Severity="Severity.Error" Class="mb-4">@_error</MudAlert>
    }

    <MudForm Model="_model">
        <MudTextField @bind-Value="_model.FirstName" Label="FirstName" Variant="Variant.Outlined" Class="mb-3" />
        <MudTextField @bind-Value="_model.LastName" Label="LastName" Variant="Variant.Outlined" Class="mb-3" />
        <MudTextField @bind-Value="_model.Email" Label="Email" Variant="Variant.Outlined" Class="mb-3" />
        <MudTextField T="DateTime" @bind-Value="_model.CreatedAt" Label="CreatedAt" Variant="Variant.Outlined" Class="mb-3" />
        @* RowVersion (rowversion) isn't auto-renderable - add a field for it by hand if needed *@
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SubmitAsync" Disabled="@_saving">Save</MudButton>
        <MudButton Variant="Variant.Text" Href="/customers">Cancel</MudButton>
    </MudForm>
}

@code {
    [Parameter] public int Id { get; set; }

    private const string ListUrl = "/customers";
    private bool _loading = true;
    private bool _saving;
    private string? _error;
    private CustomerUpdateDto _model = new();
    protected override async Task OnInitializedAsync()
    {
        var result = await Service.GetByIdAsync(Id);
        if (result.IsSuccessful && result.Data is not null)
        {
            _model.FirstName = result.Data.FirstName;
            _model.LastName = result.Data.LastName;
            _model.Email = result.Data.Email;
            _model.CreatedAt = result.Data.CreatedAt;
            _model.RowVersion = result.Data.RowVersion;
        }
        else
        {
            _error = result.Message ?? "Customer not found.";
        }

        _loading = false;
    }

    private async Task SubmitAsync()
    {
        _saving = true;
        _error = null;

        var result = await Service.UpdateAsync(Id, _model);
        if (result.IsSuccessful)
        {
            Nav.NavigateTo(ListUrl);
        }
        else
        {
            _error = result.Message;
            _saving = false;
        }
    }
}
