@* auto-generated by SQLAZOR - hand-edit freely, this file is not regenerated automatically *@
@page "/orders"
@using MudBlazor
@inject IOrderService Service

<PageTitle>Orders</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">Orders</MudText>

<MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
           Href="/orders/create" Class="mb-4">
    New Order
</MudButton>

@if (_loading)
{
    <MudProgressCircular Indeterminate="true" />
}
else if (!string.IsNullOrEmpty(_error))
{
    <MudAlert Severity="Severity.Error">@_error</MudAlert>
}
else if (_items.Count == 0)
{
    <MudText>No records found.</MudText>
}
else
{
    <MudTable Items="_items" Hover="true" Breakpoint="Breakpoint.Sm">
        <HeaderContent>
            <MudTh>OrderId</MudTh>
            <MudTh>CustomerId</MudTh>
            <MudTh>ShippedToCustomerId</MudTh>
            <MudTh>OrderDate</MudTh>
            <MudTh>Total</MudTh>
            <MudTh>Status</MudTh>
            <MudTh>RowVersion</MudTh>
            <MudTh></MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="OrderId">@context.OrderId</MudTd>
            <MudTd DataLabel="CustomerId">@context.CustomerId</MudTd>
            <MudTd DataLabel="ShippedToCustomerId">@context.ShippedToCustomerId</MudTd>
            <MudTd DataLabel="OrderDate">@context.OrderDate</MudTd>
            <MudTd DataLabel="Total">@context.Total</MudTd>
            <MudTd DataLabel="Status">@context.Status</MudTd>
            <MudTd DataLabel="RowVersion">@context.RowVersion</MudTd>
            <MudTd>
                <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Href="@GetEditUrl(context)" />
                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="() => DeleteAsync(context)" />
            </MudTd>
        </RowTemplate>
        <PagerContent>
        <MudTablePager />
        </PagerContent>
    </MudTable>
}

@code {
    private List<OrderDto> _items = [];
    private bool _loading = true;
    private string? _error;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;

        var result = await Service.GetAllAsync();
        if (result.IsSuccessful)
        {
            _items = result.Data ?? [];
        }
        else
        {
            _error = result.Message;
        }

        _loading = false;
    }

    private async Task DeleteAsync(OrderDto item)
    {
        var result = await Service.DeleteAsync(item.OrderId);
        if (result.IsSuccessful)
        {
            await LoadAsync();
        }
        else
        {
            _error = result.Message;
        }
    }

    private static string GetEditUrl(OrderDto item) => $"/orders/edit/{item.OrderId}";
}
