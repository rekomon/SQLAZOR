@* auto-generated by SQLAZOR - hand-edit freely, this file is not regenerated automatically *@
@page "/orders/create"
@using MudBlazor
@inject IOrderService Service
@inject ICustomerService CustomerLookupService
@inject NavigationManager Nav

<PageTitle>New Order</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">New Order</MudText>

@if (!string.IsNullOrEmpty(_error))
{
    <MudAlert Severity="Severity.Error" Class="mb-4">@_error</MudAlert>
}

<MudForm Model="_model">
    <MudAutocomplete T="int" @bind-Value="_model.CustomerId" SearchFunc="SearchCustomerIdAsync" ToStringFunc="CustomerIdLabel" Label="Customer" Variant="Variant.Outlined" Class="mb-3" MaxItems="50" />
    <MudAutocomplete T="int?" @bind-Value="_model.ShippedToCustomerId" SearchFunc="SearchShippedToCustomerIdAsync" ToStringFunc="ShippedToCustomerIdLabel" Label="Shipped To Customer" Variant="Variant.Outlined" Class="mb-3" MaxItems="50" />
    <MudTextField T="DateTime" @bind-Value="_model.OrderDate" Label="OrderDate" Variant="Variant.Outlined" Class="mb-3" />
    <MudNumericField T="decimal" @bind-Value="_model.Total" Label="Total" Variant="Variant.Outlined" Class="mb-3" />
    <MudTextField @bind-Value="_model.Status" Label="Status" Variant="Variant.Outlined" Class="mb-3" />
    @* RowVersion (rowversion) isn't auto-renderable - add a field for it by hand if needed *@
    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SubmitAsync" Disabled="@_saving">Create</MudButton>
    <MudButton Variant="Variant.Text" Href="/orders">Cancel</MudButton>
</MudForm>

@code {
    private const string ListUrl = "/orders";
    private bool _saving;
    private string? _error;
    private OrderCreateDto _model = new();
    private readonly Dictionary<int, string> _customerIdLabels = new();

    private async Task<IEnumerable<int>> SearchCustomerIdAsync(string? value, CancellationToken token)
    {
        var result = await CustomerLookupService.SearchAsync(value, 50, token);
        if (!result.IsSuccessful || result.Data is null)
            return [];

        foreach (var row in result.Data)
            _customerIdLabels[row.CustomerId] = $"{row.FirstName} {row.LastName}";

        return result.Data.Select(row => (int)row.CustomerId).Distinct().ToList();
    }

    private string? CustomerIdLabel(int id) =>
        _customerIdLabels.TryGetValue(id, out var label) ? label : id.ToString();

    private readonly Dictionary<int, string> _shippedToCustomerIdLabels = new();

    private async Task<IEnumerable<int?>> SearchShippedToCustomerIdAsync(string? value, CancellationToken token)
    {
        var result = await CustomerLookupService.SearchAsync(value, 50, token);
        if (!result.IsSuccessful || result.Data is null)
            return [];

        foreach (var row in result.Data)
            _shippedToCustomerIdLabels[row.CustomerId] = $"{row.FirstName} {row.LastName}";

        return result.Data.Select(row => (int?)row.CustomerId).Distinct().ToList();
    }

    private string? ShippedToCustomerIdLabel(int? id) =>
        id is { } key && _shippedToCustomerIdLabels.TryGetValue(key, out var label) ? label : id?.ToString();

    private async Task SubmitAsync()
    {
        _saving = true;
        _error = null;

        var result = await Service.CreateAsync(_model);
        if (result.IsSuccessful)
        {
            Nav.NavigateTo(ListUrl);
        }
        else
        {
            _error = result.Message;
            _saving = false;
        }
    }
}
