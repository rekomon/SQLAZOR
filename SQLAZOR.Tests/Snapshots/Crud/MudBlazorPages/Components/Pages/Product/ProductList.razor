@* auto-generated by SQLAZOR - hand-edit freely, this file is not regenerated automatically *@
@page "/products"
@using MudBlazor
@inject IProductService Service

<PageTitle>Products</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">Products</MudText>

<MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
           Href="/products/create" Class="mb-4">
    New Product
</MudButton>

@if (_loading)
{
    <MudProgressCircular Indeterminate="true" />
}
else if (!string.IsNullOrEmpty(_error))
{
    <MudAlert Severity="Severity.Error">@_error</MudAlert>
}
else if (_items.Count == 0)
{
    <MudText>No records found.</MudText>
}
else
{
    <MudTable Items="_items" Hover="true" Breakpoint="Breakpoint.Sm">
        <HeaderContent>
            <MudTh>ProductId</MudTh>
            <MudTh>Sku</MudTh>
            <MudTh>Name</MudTh>
            <MudTh>Category</MudTh>
            <MudTh>Price</MudTh>
            <MudTh>Stock</MudTh>
            <MudTh>StockValue</MudTh>
            <MudTh>AddedOn</MudTh>
            <MudTh></MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="ProductId">@context.ProductId</MudTd>
            <MudTd DataLabel="Sku">@context.Sku</MudTd>
            <MudTd DataLabel="Name">@context.Name</MudTd>
            <MudTd DataLabel="Category">@context.Category</MudTd>
            <MudTd DataLabel="Price">@context.Price</MudTd>
            <MudTd DataLabel="Stock">@context.Stock</MudTd>
            <MudTd DataLabel="StockValue">@context.StockValue</MudTd>
            <MudTd DataLabel="AddedOn">@context.AddedOn</MudTd>
            <MudTd>
                <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Href="@GetEditUrl(context)" />
                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="() => DeleteAsync(context)" />
            </MudTd>
        </RowTemplate>
        <PagerContent>
        <MudTablePager />
        </PagerContent>
    </MudTable>
}

@code {
    private List<ProductDto> _items = [];
    private bool _loading = true;
    private string? _error;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;

        var result = await Service.GetAllAsync();
        if (result.IsSuccessful)
        {
            _items = result.Data ?? [];
        }
        else
        {
            _error = result.Message;
        }

        _loading = false;
    }

    private async Task DeleteAsync(ProductDto item)
    {
        var result = await Service.DeleteAsync(item.ProductId);
        if (result.IsSuccessful)
        {
            await LoadAsync();
        }
        else
        {
            _error = result.Message;
        }
    }

    private static string GetEditUrl(ProductDto item) => $"/products/edit/{item.ProductId}";
}
