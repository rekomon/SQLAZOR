@* auto-generated by SQLAZOR - hand-edit freely, this file is not regenerated automatically *@
@page "/products/edit/{Id:int}"
@using MudBlazor
@inject IProductService Service
@inject NavigationManager Nav

<PageTitle>Edit Product</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">Edit Product</MudText>

@if (_loading)
{
    <MudProgressCircular Indeterminate="true" />
}
else
{
    @if (!string.IsNullOrEmpty(_error))
    {
        <MudAlert Severity="Severity.Error" Class="mb-4">@_error</MudAlert>
    }

    <MudForm Model="_model">
        <MudTextField @bind-Value="_model.Sku" Label="Sku" Variant="Variant.Outlined" Class="mb-3" />
        <MudTextField @bind-Value="_model.Name" Label="Name" Variant="Variant.Outlined" Class="mb-3" />
        <MudTextField @bind-Value="_model.Category" Label="Category" Variant="Variant.Outlined" Class="mb-3" />
        <MudNumericField T="decimal" @bind-Value="_model.Price" Label="Price" Variant="Variant.Outlined" Class="mb-3" />
        <MudNumericField T="int" @bind-Value="_model.Stock" Label="Stock" Variant="Variant.Outlined" Class="mb-3" />
        <MudTextField T="DateTimeOffset" @bind-Value="_model.AddedOn" Label="AddedOn" Variant="Variant.Outlined" Class="mb-3" />
        <MudCheckBox @bind-Value="_model.IsActive" Label="IsActive" Class="mb-3" />
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SubmitAsync" Disabled="@_saving">Save</MudButton>
        <MudButton Variant="Variant.Text" Href="/products">Cancel</MudButton>
    </MudForm>
}

@code {
    [Parameter] public int Id { get; set; }

    private const string ListUrl = "/products";
    private bool _loading = true;
    private bool _saving;
    private string? _error;
    private ProductUpdateDto _model = new();
    protected override async Task OnInitializedAsync()
    {
        var result = await Service.GetByIdAsync(Id);
        if (result.IsSuccessful && result.Data is not null)
        {
            _model.Sku = result.Data.Sku;
            _model.Name = result.Data.Name;
            _model.Category = result.Data.Category;
            _model.Price = result.Data.Price;
            _model.Stock = result.Data.Stock;
            _model.AddedOn = result.Data.AddedOn;
            _model.IsActive = result.Data.IsActive;
        }
        else
        {
            _error = result.Message ?? "Product not found.";
        }

        _loading = false;
    }

    private async Task SubmitAsync()
    {
        _saving = true;
        _error = null;

        var result = await Service.UpdateAsync(Id, _model);
        if (result.IsSuccessful)
        {
            Nav.NavigateTo(ListUrl);
        }
        else
        {
            _error = result.Message;
            _saving = false;
        }
    }
}
