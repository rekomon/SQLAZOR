@page "/products/create"
@using MudBlazor
@inject IProductService Service
@inject NavigationManager Nav

<PageTitle>New Product</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">New Product</MudText>

@if (!string.IsNullOrEmpty(_error))
{
    <MudAlert Severity="Severity.Error" Class="mb-4">@_error</MudAlert>
}

<MudForm Model="_model">
    <MudTextField @bind-Value="_model.Sku" Label="Sku" Variant="Variant.Outlined" Class="mb-3" />
    <MudTextField @bind-Value="_model.Name" Label="Name" Variant="Variant.Outlined" Class="mb-3" />
    <MudTextField @bind-Value="_model.Category" Label="Category" Variant="Variant.Outlined" Class="mb-3" />
    <MudNumericField T="decimal" @bind-Value="_model.Price" Label="Price" Variant="Variant.Outlined" Class="mb-3" />
    <MudNumericField T="int" @bind-Value="_model.Stock" Label="Stock" Variant="Variant.Outlined" Class="mb-3" />
    <MudTextField T="DateTimeOffset" @bind-Value="_model.AddedOn" Label="AddedOn" Variant="Variant.Outlined" Class="mb-3" />
    <MudCheckBox @bind-Value="_model.IsActive" Label="IsActive" Class="mb-3" />
    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SubmitAsync" Disabled="@_saving">Create</MudButton>
    <MudButton Variant="Variant.Text" Href="/products">Cancel</MudButton>
</MudForm>

@code {
    private const string ListUrl = "/products";
    private bool _saving;
    private string? _error;
    private ProductCreateDto _model = new();
    private async Task SubmitAsync()
    {
        _saving = true;
        _error = null;

        var result = await Service.CreateAsync(_model);
        if (result.IsSuccessful)
        {
            Nav.NavigateTo(ListUrl);
        }
        else
        {
            _error = result.Message;
            _saving = false;
        }
    }
}
