@* auto-generated by SQLAZOR - hand-edit freely, this file is not regenerated automatically *@
@page "/orderlines"
@using MudBlazor
@inject IOrderLineService Service

<PageTitle>OrderLines</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">OrderLines</MudText>

<MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
           Href="/orderlines/create" Class="mb-4">
    New OrderLine
</MudButton>

@if (_loading)
{
    <MudProgressCircular Indeterminate="true" />
}
else if (!string.IsNullOrEmpty(_error))
{
    <MudAlert Severity="Severity.Error">@_error</MudAlert>
}
else if (_items.Count == 0)
{
    <MudText>No records found.</MudText>
}
else
{
    <MudTable Items="_items" Hover="true" Breakpoint="Breakpoint.Sm">
        <HeaderContent>
            <MudTh>OrderId</MudTh>
            <MudTh>LineNumber</MudTh>
            <MudTh>ProductId</MudTh>
            <MudTh>Quantity</MudTh>
            <MudTh>UnitPrice</MudTh>
            <MudTh></MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="OrderId">@context.OrderId</MudTd>
            <MudTd DataLabel="LineNumber">@context.LineNumber</MudTd>
            <MudTd DataLabel="ProductId">@context.ProductId</MudTd>
            <MudTd DataLabel="Quantity">@context.Quantity</MudTd>
            <MudTd DataLabel="UnitPrice">@context.UnitPrice</MudTd>
            <MudTd>
                <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Href="@GetEditUrl(context)" />
                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="() => DeleteAsync(context)" />
            </MudTd>
        </RowTemplate>
        <PagerContent>
        <MudTablePager />
        </PagerContent>
    </MudTable>
}

@code {
    private List<OrderLineDto> _items = [];
    private bool _loading = true;
    private string? _error;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;

        var result = await Service.GetAllAsync();
        if (result.IsSuccessful)
        {
            _items = result.Data ?? [];
        }
        else
        {
            _error = result.Message;
        }

        _loading = false;
    }

    private async Task DeleteAsync(OrderLineDto item)
    {
        var result = await Service.DeleteAsync(item.OrderId, item.LineNumber);
        if (result.IsSuccessful)
        {
            await LoadAsync();
        }
        else
        {
            _error = result.Message;
        }
    }

    private static string GetEditUrl(OrderLineDto item) => $"/orderlines/edit/{item.OrderId}/{item.LineNumber}";
}
