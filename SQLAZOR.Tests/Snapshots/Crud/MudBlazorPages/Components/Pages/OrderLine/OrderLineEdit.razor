@* auto-generated by SQLAZOR - hand-edit freely, this file is not regenerated automatically *@
@page "/orderlines/edit/{OrderId:int}/{LineNumber:int}"
@using MudBlazor
@inject IOrderLineService Service
@inject IProductService ProductLookupService
@inject NavigationManager Nav

<PageTitle>Edit OrderLine</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">Edit OrderLine</MudText>

@if (_loading)
{
    <MudProgressCircular Indeterminate="true" />
}
else
{
    @if (!string.IsNullOrEmpty(_error))
    {
        <MudAlert Severity="Severity.Error" Class="mb-4">@_error</MudAlert>
    }

    <MudForm Model="_model">
        <MudAutocomplete T="int" @bind-Value="_model.ProductId" SearchFunc="SearchProductIdAsync" ToStringFunc="ProductIdLabel" Label="Product" Variant="Variant.Outlined" Class="mb-3" MaxItems="50" />
        <MudNumericField T="int" @bind-Value="_model.Quantity" Label="Quantity" Variant="Variant.Outlined" Class="mb-3" />
        <MudNumericField T="decimal" @bind-Value="_model.UnitPrice" Label="UnitPrice" Variant="Variant.Outlined" Class="mb-3" />
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SubmitAsync" Disabled="@_saving">Save</MudButton>
        <MudButton Variant="Variant.Text" Href="/orderlines">Cancel</MudButton>
    </MudForm>
}

@code {
    [Parameter] public int OrderId { get; set; }
    [Parameter] public int LineNumber { get; set; }

    private const string ListUrl = "/orderlines";
    private bool _loading = true;
    private bool _saving;
    private string? _error;
    private OrderLineUpdateDto _model = new();
    private readonly Dictionary<int, string> _productIdLabels = new();

    private async Task<IEnumerable<int>> SearchProductIdAsync(string? value, CancellationToken token)
    {
        var result = await ProductLookupService.SearchAsync(value, 50, token);
        if (!result.IsSuccessful || result.Data is null)
            return [];

        foreach (var row in result.Data)
            _productIdLabels[row.ProductId] = row.Name;

        return result.Data.Select(row => (int)row.ProductId).Distinct().ToList();
    }

    private string? ProductIdLabel(int id) =>
        _productIdLabels.TryGetValue(id, out var label) ? label : id.ToString();

    protected override async Task OnInitializedAsync()
    {
        var result = await Service.GetByIdAsync(OrderId, LineNumber);
        if (result.IsSuccessful && result.Data is not null)
        {
            _model.ProductId = result.Data.ProductId;
            _model.Quantity = result.Data.Quantity;
            _model.UnitPrice = result.Data.UnitPrice;
        }
        else
        {
            _error = result.Message ?? "OrderLine not found.";
        }

        if (_model.ProductId is { } currentProductId)
        {
            var seedProductId = await ProductLookupService.GetByIdAsync(currentProductId);
            if (seedProductId.IsSuccessful && seedProductId.Data is not null)
                _productIdLabels[currentProductId] = seedProductId.Data.Name;
        }

        _loading = false;
    }

    private async Task SubmitAsync()
    {
        _saving = true;
        _error = null;

        var result = await Service.UpdateAsync(OrderId, LineNumber, _model);
        if (result.IsSuccessful)
        {
            Nav.NavigateTo(ListUrl);
        }
        else
        {
            _error = result.Message;
            _saving = false;
        }
    }
}
